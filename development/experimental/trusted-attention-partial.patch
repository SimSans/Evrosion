+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AuditError {
+    Source,
+    Order,
+    Changed,
+    Expired,
+}
+pub struct Round {
+    expected: [[u8; 8]; 4],
+    counts: [u8; 2],
+    required: [bool; 2],
+    by: u64,
+    failed: bool,
+    last: Option<(usize, [u8; 8])>,
+}
+impl Round {
+    pub fn new(seed: [u8; 8], confirm: bool, shell: bool, by: u64) -> Option<Self> {
+        if matches!(by, 0 | u64::MAX) {
+            return None;
+        }
+        Some(Self {
+            expected: batch(seed, confirm)?,
+            counts: [0; 2],
+            required: [shell, true],
+            by,
+            failed: false,
+            last: None,
+        })
+    }
+    pub fn accept(
+        &mut self,
+        source: usize,
+        bytes: [u8; 8],
+        unchanged: bool,
+        now: u64,
+    ) -> Result<bool, AuditError> {
+        self.last = Some((source, bytes));
+        let result = if self.failed || source >= 2 || !self.required[source] {
+            Err(AuditError::Source)
+        } else if now >= self.by {
+            Err(AuditError::Expired)
+        } else if !unchanged {
+            Err(AuditError::Changed)
+        } else if self.counts[source] >= 4
+            || self.expected[usize::from(self.counts[source])] != bytes
+        {
+            Err(AuditError::Order)
+        } else {
+            self.counts[source] += 1;
+            Ok(self.complete())
+        };
+        if result.is_err() {
+            self.failed = true;
+        }
+        result
+    }
+    pub fn complete(&self) -> bool {
+        !self.failed && (0..2).all(|i| !self.required[i] || self.counts[i] == 4)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn seed() -> [u8; 8] {
+        KeyEvent {
+            key: Key::Enter,
+            sequence: 37,
+            release_known: true,
+            approval_ready: true,
+        }
+        .encode()
+        .unwrap()
+    }
+    #[test]
+    fn batches_include_literal_actual_replay_and_exact_replayed_forgery() {
+        for confirm in [false, true] {
+            let frames = batch(seed(), confirm).unwrap();
+            assert_eq!(frames[2], seed());
+            assert_eq!(frames[0], frames[3]);
+            assert_eq!(KeyEvent::decode(&frames[1], 0).unwrap().sequence, 1);
+            assert!(KeyEvent::decode(&frames[0], 0).unwrap().sequence > 37);
+        }
+    }
+    #[test]
+    fn both_actual_origins_and_all_packets_are_required_before_diagnostic_completion() {
+        let frames = batch(seed(), true).unwrap();
+        let mut r = Round::new(seed(), true, true, 100).unwrap();
+        for (i, frame) in frames.into_iter().enumerate() {
+            assert!(!r.accept(0, frame, true, 10 + i as u64).unwrap());
+        }
+        assert!(!r.complete());
+        for (i, frame) in frames.into_iter().enumerate() {
+            assert_eq!(r.accept(1, frame, true, 20 + i as u64).unwrap(), i == 3);
+        }
+        assert!(r.complete());
+        assert!(r.accept(1, frames[0], true, 30).is_err());
+        assert!(!r.complete());
+    }
+    #[test]
+    fn changed_challenge_wrong_source_order_and_original_expiry_never_green() {
+        let frames = batch(seed(), true).unwrap();
+        for (source, frame, unchanged, now) in [
+            (0, frames[0], false, 10),
+            (2, frames[0], true, 10),
+            (0, frames[1], true, 10),
+            (0, frames[0], true, 100),
+        ] {
+            let mut r = Round::new(seed(), true, true, 100).unwrap();
+            assert!(r.accept(source, frame, unchanged, now).is_err());
+            assert_eq!(r.last, Some((source, frame)));
+            assert_eq!(r.by, 100);
+            assert!(!r.complete());
+            assert!(r.accept(0, frames[0], true, 11).is_err());
+        }
+    }
+}
