+//! Selected internal negative-test bytes. No packet identifies a trusted sender.
+use ev_userspace_contract::focused_input::{Key, KeyEvent};
+pub const SEED_FIELD: u8 = 127;
+pub const ENTRY: u16 = 0xf000;
+pub const CONFIRM: u16 = 0xf001;
+pub const ENTRY_OK: u16 = 0xf101;
+pub const CONFIRM_OK: u16 = 0xf102;
+pub const HANG_OK: u16 = 0xf103;
+pub const DEAD_OK: u16 = 0xf104;
+pub const POST_OK: u16 = 0xf105;
+pub const HANG_MARK: u8 = 0xd0;
+pub const DEAD_MARK: u8 = 0xd1;
+#[derive(Default)]
+pub struct Seed {
+    low: Option<u32>,
+    bytes: Option<[u8; 8]>,
+}
+impl Seed {
+    pub fn put(&mut self, high: bool, word: u32) -> bool {
+        if !high {
+            self.low = Some(word);
+            self.bytes = None;
+            return true;
+        }
+        let Some(low) = self.low.take() else {
+            return false;
+        };
+        let bytes = ((u64::from(word) << 32) | u64::from(low)).to_le_bytes();
+        if KeyEvent::decode(&bytes, 0).is_err() {
+            return false;
+        }
+        self.bytes = Some(bytes);
+        true
+    }
+    pub fn batch(&self, confirm: bool) -> Option<[[u8; 8]; 4]> {
+        batch(self.bytes?, confirm)
+    }
+}
+pub fn batch(actual_previous_input: [u8; 8], confirm: bool) -> Option<[[u8; 8]; 4]> {
+    KeyEvent::decode(&actual_previous_input, 0).ok()?;
+    let event = KeyEvent {
+        key: if confirm { Key::Enter } else { Key::Escape },
+        sequence: u32::MAX - 2,
+        release_known: confirm,
+        approval_ready: confirm,
+    };
+    let fresh = event.encode().ok()?;
+    let stale = KeyEvent {
