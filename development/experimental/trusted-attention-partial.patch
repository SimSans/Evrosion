+                }
+            }
+        }
+    }
+    pub(super) fn attention_require_complete(&mut self) {
+        require(
+            self.attention.entry_done
+                && self.attention.confirm_done
+                && self.attention.fault_verified
+                && self.attention.post_done
+                && self.attention.revoked
+                && self.attention.reopened
+                && self.attention.round.is_none(),
+            1807,
+        );
