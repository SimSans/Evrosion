+            let shell = self.actor(Child::Shell);
+            let r = rt::call(s::OBSERVE, shell.control, 0, 0);
+            require(
+                self.attention.shell == Some(shell.identity)
+                    && !shell.failed
+                    && r.status == 0
+                    && r.value == 0
+                    && r.capability == 0,
+                1808,
+            );
+        }
+    }
