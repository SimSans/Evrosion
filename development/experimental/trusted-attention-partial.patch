+//! Selected native negative qualification. Never authorizes a request.
+use super::*;
+use ev_userspace_contract::focused_input::KeyEvent;
+use ev_workspace_root::trusted_attention_wire as wire;
+type Scope = (
+    filegrant::Facts,
+    owner::Request,
+    ev_userspace_contract::workspace::DatasetId,
+);
+#[derive(PartialEq, Eq)]
+pub(super) struct Snapshot {
+    input: (u32, u32, i32, i32, u8),
+    pending: Option<owner::Request>,
+    challenge: Option<ev_workspace_shell::Challenge>,
+    witness: bool,
+    rearm: bool,
+    input_nonce: u32,
+    shell_gesture: Option<(u8, Identity, u64, u64)>,
+    header: v5::surface::Header,
+    scopes: [Option<Scope>; 4],
+    grant: bool,
+    layer: Layer,
+}
+pub(super) struct State {
+    seed: Option<[u8; 8]>,
+    round: Option<wire::Round>,
+    kind: u8,
+    held_nonce: u64,
+    entry_started: bool,
+    entry_done: bool,
+    confirm_started: bool,
+    confirm_done: bool,
+    first_nonce: u64,
+    fault: u8,
+    fault_by: u64,
+    shell: Option<Identity>,
+    cpu_start: u64,
+    fault_verified: bool,
+    post_started: bool,
+    post_done: bool,
+    original: Option<Scope>,
+    revoked: bool,
+    reopened: bool,
+}
+impl State {
+    pub const fn new() -> Self {
+        Self {
+            seed: None,
+            round: None,
+            kind: 0,
+            held_nonce: 0,
+            entry_started: false,
+            entry_done: false,
+            confirm_started: false,
+            confirm_done: false,
+            first_nonce: 0,
+            fault: 0,
+            fault_by: 0,
+            shell: None,
+            cpu_start: 0,
+            fault_verified: false,
+            post_started: false,
+            post_done: false,
+            original: None,
+            revoked: false,
+            reopened: false,
+        }
+    }
+}
+impl Root<'_> {
+    pub(super) fn attention_snapshot(&self) -> Snapshot {
+        Snapshot {
+            input: self.input.attention_state(),
+            pending: self.owner.pending,
+            challenge: self.owner.challenge,
+            witness: self.owner.witness.is_some(),
+            rearm: self.owner.rearm,
+            input_nonce: self.owner.input_nonce,
+            shell_gesture: self.shell_gesture,
+            header: self.protected.header,
+            scopes: self.attention_file_scopes(),
+            grant: self.grant.is_some(),
+            layer: self
+                .policy
+                .as_ref()
+                .map_or(Layer::Simple, |p| p.desktop.view().layer),
+        }
+    }
+    fn attention_seed_to(&mut self, child: Child) {
+        let seed = self.attention.seed.unwrap_or_else(|| rt::exit(1780));
+        let n = u64::from_le_bytes(seed);
+        for (high, word) in [(false, n as u32), (true, (n >> 32) as u32)] {
+            require(
+                self.queue(
+                    child,
+                    Command::InfoWord {
+                        field: wire::SEED_FIELD,
+                        high,
+                        word,
+                    },
+                ),
+                1781,
+            );
+        }
+    }
+    pub(super) fn attention_prepare_shell(&mut self, window: u8) {
+        if window != 2 || self.attention.entry_started {
+            return;
+        }
+        require(self.owner.pending.is_none() && self.grant.is_none(), 1782);
+        let original = self.attention_file_scopes()[1].unwrap_or_else(|| rt::exit(1783));
+        require(self.states[1] == Some(AppState::Saved), 1784);
+        self.attention.original = Some(original);
+        self.attention.entry_started = true;
+        self.attention.kind = 0;
+        self.attention.round = wire::Round::new(
+            self.attention.seed.unwrap_or_else(|| rt::exit(1785)),
+            false,
+            true,
+            deadline(v5::resources::FILE_TRANSACTION_TICKS),
+        );
+        require(self.attention.round.is_some(), 1786);
+        self.attention_seed_to(Child::Shell);
+        self.attention_seed_to(Child::EditorTwo);
+        require(
+            self.queue(Child::EditorTwo, Command::Activate(wire::ENTRY)),
+            1787,
+        );
+    }
+    pub(super) fn attention_after(&mut self, child: Child, bytes: [u8; 8], before: Snapshot) {
+        if child == Child::Input {
+            if let Ok(event) = KeyEvent::decode(&bytes, 0)
+                && self.input.attention_state().0 == event.sequence
+            {
+                self.attention.seed = Some(bytes);
+            }
+            return;
+        }
+        if matches!(child, Child::Shell | Child::EditorTwo) && KeyEvent::decode(&bytes, 0).is_ok() {
+            let after = self.attention_snapshot();
+            require(!before.grant, 1809);
+            if self.attention.kind != 0 {
+                require(
+                    before
+                        .challenge
+                        .is_some_and(|c| c.nonce == self.attention.held_nonce)
+                        && before.witness,
+                    1788,
+                );
+            } else {
+                require(before.pending.is_none() && !before.grant, 1789);
+            }
+            if self.attention.kind != 0 {
+                require(
+                    !before.rearm
+                        && before.pending.is_some_and(|p| {
+                            p.index == 1 && p.purpose == filegrant::Purpose::Revoke
+                        }),
+                    1810,
+                );
+            }
+            let source = usize::from(child == Child::EditorTwo);
+            let complete = self
+                .attention
+                .round
+                .as_mut()
+                .unwrap_or_else(|| rt::exit(1790))
+                .accept(source, bytes, before == after, now())
+                .unwrap_or_else(|_| rt::exit(1791));
+            if complete {
+                self.attention.round = None;
+                let code = match self.attention.kind {
+                    0 => {
+                        self.attention.entry_done = true;
+                        wire::ENTRY_OK
+                    }
+                    1 => {
+                        self.attention.confirm_done = true;
+                        wire::CONFIRM_OK
+                    }
+                    _ => {
+                        self.attention.post_done = true;
+                        wire::POST_OK
+                    }
+                };
+                require(self.queue(Child::EditorTwo, Command::Activate(code)), 1792);
+            }
+            return;
+        }
+        if child == Child::Shell && self.attention.fault == 0 {
+            let mode = match Event::decode(bytes) {
+                Ok(Event::Refused(wire::HANG_MARK)) => 1,
+                Ok(Event::Refused(wire::DEAD_MARK)) => 2,
+                _ => 0,
+            };
