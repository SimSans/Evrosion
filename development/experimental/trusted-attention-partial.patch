+                    1793,
+                );
+                self.attention.fault = mode;
+                self.attention.fault_by = deadline(v5::resources::FILE_TRANSACTION_TICKS);
+                let actor = self.actor(Child::Shell);
+                self.attention.shell = Some(actor.identity);
+                self.attention.cpu_start = self.attention_shell_cpu();
+            }
+        }
+    }
+    fn attention_shell_cpu(&self) -> u64 {
+        let r = rt::call(s::PROCESS_JOB_INFO, self.actor(Child::Shell).control, 1, 0);
+        require(r.status == 0 && r.capability == 0, 1794);
+        r.value
+    }
+    fn attention_begin_confirm(&mut self, kind: u8, shell: bool) {
+        require(
+            self.owner
+                .pending
+                .is_some_and(|p| p.index == 1 && p.purpose == filegrant::Purpose::Revoke),
+            1811,
+        );
+        let nonce = self.owner.nonce();
+        require(
+            nonce != 0 && self.owner.witness.is_some() && !self.owner.rearm,
+            1795,
+        );
+        self.attention.kind = kind;
+        self.attention.held_nonce = nonce;
+        self.attention.round = wire::Round::new(
+            self.attention.seed.unwrap_or_else(|| rt::exit(1796)),
+            true,
+            shell,
+            deadline(v5::resources::FILE_TRANSACTION_TICKS),
+        );
+        require(self.attention.round.is_some(), 1797);
+        if shell {
+            self.attention_seed_to(Child::Shell);
+            require(
+                self.queue(Child::Shell, Command::Activate(wire::CONFIRM)),
+                1798,
+            );
+        }
+        self.attention_seed_to(Child::EditorTwo);
+        require(
+            self.queue(Child::EditorTwo, Command::Activate(wire::CONFIRM)),
+            1799,
+        );
+    }
+    pub(super) fn attention_tick(&mut self) {
+        if self.attention.entry_done
+            && !self.attention.confirm_started
+            && self.owner.witness.is_some()
+            && !self.owner.rearm
