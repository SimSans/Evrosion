+            && !self.attention.post_started
+            && self.owner.witness.is_some()
+            && !self.owner.rearm
+        {
+            require(self.owner.nonce() != self.attention.first_nonce, 1805);
+            self.attention.post_started = true;
+            self.attention_begin_confirm(2, false);
+        }
