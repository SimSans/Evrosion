+    /// One-object reclaim uses held facts, actual61 and independent service
+    /// reconciliation without closing the application or its private copy.
+    pub(super) fn reclaim_retire_file(
+        &mut self,
+        index: usize,
+        target: ev_workspace_root::reclaim::Facts,
+        cut: u64,
+    ) -> Result<bool, ()> {
+        if !matches!(index, 1 | 2)
+            || now() >= cut
+            || self.grant.is_some()
+            || self.owner.pending.is_some()
+        {
+            return Err(());
+        }
+        let Some(lease) = self.leases[index].as_ref() else {
+            return Ok(true);
+        };
+        if lease.dataset.0 != target.dataset
+            || lease.selection.entry.map(|e| e.object) != Some(target.entry.object)
+        {
+            return Ok(true);
+        }
+        let facts = lease.facts;
+        let actor = self.actor(app_child(index).ok_or(())?);
+        if actor.identity != facts.identity || actor.control != facts.held_control {
+            return Err(());
+        }
+        if !lease
+            .receipt
+            .as_ref()
+            .is_some_and(|r| r.facts == facts && r.held_control == actor.control)
+        {
+            self.reclaim.admit(now())?;
+            let info = rt::call4(s::MANAGED_SEND_RETIRE_INFO, 0, 0, 0, 0);
+            self.reclaim.admit(now())?;
+            if info.status != 0
+                || info.value != s::MANAGED_SEND_RETIRE_V1
+                || info.capability != 0
+                || info.serial != 0
+            {
+                return Err(());
+            }
+            let actual = rt::call4(
+                s::MANAGED_SEND_RETIRE,
+                actor.control,
+                u64::from(facts.nonce),
+                0,
+                0,
+            );
+            self.reclaim.last_retire = Some((actor.control, facts.nonce, actual));
+            if actual.status != 0 || actual.capability != 0 || actual.serial != 0 {
+                return Err(());
+            }
+            match actual.value {
+                0 => {
+                    self.leases[index].as_mut().unwrap().receipt = Some(Receipt {
+                        facts,
+                        held_control: actor.control,
+                        _kind: ReceiptKind::Drained,
+                    });
+                    self.lease_rights[index] = 0;
+                }
+                1 => {
+                    self.lease_rights[index] = 0;
+                    return if now() < cut { Ok(false) } else { Err(()) };
+                }
+                _ => return Err(()),
+            }
+            self.reclaim.admit(now())?;
+        }
+        self.reconcile_file(index, actor, facts, cut)
+    }
