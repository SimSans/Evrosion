diff --git a/services/workspace-root/src/native/reclaim.rs b/services/workspace-root/src/native/reclaim.rs
new file mode 100644
--- /dev/null
+++ b/services/workspace-root/src/native/reclaim.rs
@@ -0,0 +1,604 @@
+//! Root-only permanent single-object removal. Every accepted owner, exact
+//! lease retirement, original cut and unknown transport remains retained.
+use super::*;
+use ev_userspace_contract::workspace::{
+    Entry, EntryState, Kind, Name, ObjectId, Operation, Outcome,
+};
+use ev_workspace_root::reclaim::{Approval, Facts};
+use ev_workspace_root::render;
+use ev_workspace_service::control;
+use ev_workspace_shell::{Challenge, ConfirmationSource, PresentedWitness};
+const ROOT: ObjectId = ObjectId {
+    slot: 0,
+    generation: 1,
+};
+
+struct Dialog {
+    facts: Facts,
+    challenge: Challenge,
+    witness: Option<PresentedWitness>,
+    rearm: bool,
+    cut: u64,
+    drained: bool,
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    Retire(usize),
+    Purge,
+    Complete,
+    Fenced,
+}
+struct Pending {
+    approval: Approval,
+    phase: Phase,
+    reply: Option<control::PurgeResponse>,
+}
+pub(super) struct Controller {
+    browsing: bool,
+    directory: ObjectId,
+    cursor: u16,
+    next: Option<u16>,
+    entry: Option<Entry>,
+    dataset: [u8; 16],
+    namespace: u64,
+    location: Name,
+    drain_cut: u64,
+    drained: bool,
+    dialog: Option<Dialog>,
+    pending: Option<Pending>,
+    status: &'static [u8],
+    pub last_retire: Option<(u64, u32, rt::CapReply)>,
+}
+impl Controller {
+    pub const fn new() -> Self {
+        Self {
+            browsing: false,
+            directory: ROOT,
+            cursor: 0,
+            next: None,
+            entry: None,
+            dataset: [0; 16],
+            namespace: 0,
+            location: Name::root(),
+            drain_cut: 0,
+            drained: false,
+            dialog: None,
+            pending: None,
+            status: b"Choose one trashed file or empty directory",
+            last_retire: None,
+        }
+    }
+    pub fn active(&self) -> bool {
+        self.browsing || self.dialog.is_some() || self.pending.is_some()
+    }
+    pub fn dialog(&self) -> bool {
+        self.dialog.is_some()
+    }
+    pub fn browsing(&self) -> bool {
+        self.browsing
+    }
+    pub fn armed(&self) -> bool {
+        self.dialog
+            .as_ref()
+            .is_some_and(|d| d.witness.is_some() && !d.rearm)
+    }
+    pub fn needs_barrier(&self) -> bool {
+        self.dialog.as_ref().is_some_and(|d| d.rearm && d.drained)
+    }
+    pub fn nonce(&self) -> u64 {
+        self.dialog.as_ref().map_or_else(
+            || self.pending.as_ref().map_or(0, |p| p.approval.nonce()),
+            |d| d.challenge.nonce,
+        )
+    }
+    pub fn cut(&self) -> Option<u64> {
+        self.pending
+            .as_ref()
+            .filter(|p| p.phase != Phase::Fenced)
+            .map(|p| p.approval.cut())
+    }
+    pub fn admit(&mut self, now: u64) -> Result<(), ()> {
+        self.pending
+            .as_mut()
+            .ok_or(())?
+            .approval
+            .admit(now)
+            .map_err(|_| ())
+    }
+    pub fn view(&self) -> Option<(render::Mode, Option<Entry>, [u8; 16], render::ReclaimView)> {
+        if !self.active() {
+            return None;
+        }
+        let (mode, entry, dataset, namespace) = if let Some(d) = &self.dialog {
+            (
+                render::Mode::ReclaimConfirm,
+                Some(d.facts.entry),
+                d.facts.dataset,
+                d.facts.namespace,
+            )
+        } else if let Some(p) = &self.pending {
+            let f = p.approval.facts();
+            (
+                render::Mode::ReclaimPending,
+                Some(f.entry),
+                f.dataset,
+                f.namespace,
+            )
+        } else {
+            (
+                render::Mode::ReclaimPicker,
+                self.entry,
+                self.dataset,
+                self.namespace,
+            )
+        };
+        Some((
+            mode,
+            entry,
+            dataset,
+            render::ReclaimView {
+                namespace,
+                nonce: self.nonce(),
+                location: self.location,
+                status: self.status,
+            },
+        ))
+    }
+}
+impl Root<'_> {
+    pub(super) fn reclaim_request(&mut self) {
+        if self.reclaim.active()
+            || self.shutdown.active()
+            || self.development.active()
+            || self.owner.pending.is_some()
+            || self.grant.is_some()
+            || self.semantic.active()
+            || self.outbox.has_pending()
+            || self.protected.is_fenced()
+            || !self.app_data_can_stop()
+        {
+            return;
+        }
+        self.reclaim.browsing = true;
+        self.reclaim.drain_cut = deadline(v5::resources::FILE_TRANSACTION_TICKS);
+        self.reclaim.drained = false;
+        self.reclaim.directory = ROOT;
+        self.reclaim.cursor = 0;
+        self.reclaim_refresh();
+    }
+    fn reclaim_refresh(&mut self) {
+        if !self.reclaim.browsing {
+            return;
+        }
+        let cut = deadline(v5::resources::FILE_TRANSACTION_TICKS);
+        let result = self
+            .workspace
+            .namespace_until(
+                self.channel(Channel::RootWorkspaceControl),
+                Operation::Inspect {
+                    object: self.reclaim.directory,
+                },
+                cut,
+            )
+            .and_then(|inspected| {
+                let query = ev_workspace_root::picker::after_inspect(
+                    self.reclaim.directory,
+                    self.reclaim.cursor,
+                    None,
+                    inspected,
+                )
+                .ok_or(())?;
+                self.reclaim.location = inspected.entry.ok_or(())?.name;
+                self.workspace.namespace_until(
+                    self.channel(Channel::RootWorkspaceControl),
+                    query.operation,
+                    cut,
+                )
+            });
+        match result {
+            Ok(r) if matches!(r.outcome, Outcome::Completed | Outcome::End) => {
+                self.reclaim.entry = r.entry;
+                self.reclaim.next = r.next_cursor;
+                self.reclaim.dataset = r.dataset.0;
+                self.reclaim.namespace = r.namespace_revision;
+            }
+            _ => {
+                self.reclaim.browsing = false;
+                self.status = b"Reclaim listing unavailable; no storage was reclaimed";
+            }
+        }
+        self.owner.dirty = true;
+    }
+    pub(super) fn reclaim_browse(&mut self, action: u8, serial: u32) {
+        if !self.reclaim.browsing {
+            return;
+        }
+        match action {
+            0 => self.reclaim.cursor = 0,
+            1 => {
+                if let Some(next) = self.reclaim.next {
+                    self.reclaim.cursor = next;
+                } else {
+                    return;
+                }
+            }
+            2 => {
+                if self.reclaim.directory == ROOT {
+                    return;
+                }
+                let r = self.workspace.namespace(
+                    self.channel(Channel::RootWorkspaceControl),
+                    Operation::Inspect {
+                        object: self.reclaim.directory,
+                    },
+                );
+                let Some(parent) = r
+                    .ok()
+                    .filter(|r| r.outcome == Outcome::Completed)
+                    .and_then(|r| r.entry)
+                    .map(|e| e.parent)
+                else {
+                    return;
+                };
+                self.reclaim.directory = parent;
+                self.reclaim.cursor = 0;
+            }
+            3 => {
+                let Some(entry) = self.reclaim.entry else {
+                    return;
+                };
+                if entry.state == EntryState::Live && entry.kind == Kind::Directory {
+                    self.reclaim.directory = entry.object;
+                    self.reclaim.cursor = 0;
+                } else {
+                    self.reclaim_challenge(serial);
+                    return;
+                }
+            }
+            _ => return,
+        }
+        self.reclaim_refresh();
+    }
+    fn reclaim_facts_current(&mut self, facts: Facts, cut: u64) -> bool {
+        if !facts.valid() || facts.root != self.protected.identity || now() >= cut {
+            return false;
+        }
+        let exact = self
+            .workspace
+            .namespace_until(
+                self.channel(Channel::RootWorkspaceControl),
+                Operation::Inspect {
+                    object: facts.entry.object,
+                },
+                cut,
+            )
+            .is_ok_and(|r| {
+                r.outcome == Outcome::Completed
+                    && r.dataset.0 == facts.dataset
+                    && r.namespace_revision == facts.namespace
+                    && r.entry == Some(facts.entry)
+            })
+            && now() < cut;
+        if !exact {
+            return false;
+        }
+        if facts.entry.kind == Kind::Directory {
+            self.workspace
+                .namespace_until(
+                    self.channel(Channel::RootWorkspaceControl),
+                    Operation::List {
+                        directory: facts.entry.object,
+                        cursor: 0,
+                        expected_namespace_revision: facts.namespace,
+                    },
+                    cut,
+                )
+                .is_ok_and(|r| {
+                    r.outcome == Outcome::End
+                        && r.entry.is_none()
+                        && r.dataset.0 == facts.dataset
+                        && r.namespace_revision == facts.namespace
+                })
+                && now() < cut
+        } else {
+            true
+        }
+    }
+    fn reclaim_challenge(&mut self, serial: u32) {
+        let Some(entry) = self.reclaim.entry else {
+            return;
+        };
+        let facts = Facts {
+            root: self.protected.identity,
+            dataset: self.reclaim.dataset,
+            namespace: self.reclaim.namespace,
+            entry,
+        };
+        let cut = deadline(v5::resources::FILE_TRANSACTION_TICKS);
+        if !self.reclaim_facts_current(facts, cut) {
+            self.reclaim.status = b"Only a current trashed file or empty directory is eligible";
+            self.owner.dirty = true;
+            return;
+        }
+        let policy = self.policy.as_mut().unwrap();
+        let Ok(attention) = policy
+            .trusted
+            .attest_attention(&mut policy.desktop, self.input.serial(serial))
+        else {
+            return;
+        };
+        let Ok(challenge) = policy
+            .trusted
+            .challenge(&mut policy.desktop, attention, facts.scope())
+        else {
+            return;
+        };
+        self.reclaim.browsing = false;
+        self.reclaim.dialog = Some(Dialog {
+            facts,
+            challenge,
+            witness: None,
+            rearm: true,
+            cut,
+            drained: self.reclaim.drained,
+        });
+        self.reclaim.status =
+            b"Permanent removal ends Restore for this exact object; private copies remain";
+        self.owner.dirty = true;
+    }
+    pub(super) fn reclaim_cancel(&mut self) {
+        if self.reclaim.pending.is_some() {
+            return;
+        }
+        self.reclaim.browsing = false;
+        self.reclaim.dialog = None;
+        let policy = self.policy.as_mut().unwrap();
+        let _ = policy.trusted.cancel(&mut policy.desktop);
+        self.input.cancel();
+        self.owner.dirty = true;
+    }
+    pub(super) fn reclaim_presented(&mut self, frame: u64) {
+        if !self.reclaim.needs_barrier() {
+            return;
+        }
+        let (facts, cut) = self
+            .reclaim
+            .dialog
+            .as_ref()
+            .map(|d| (d.facts, d.cut))
+            .unwrap();
+        if !self.reclaim_facts_current(facts, cut) {
+            self.reclaim_cancel();
+            return;
+        }
+        let Some(nonce) = self
+            .owner
+            .input_nonce
+            .checked_add(1)
+            .filter(|v| *v != u32::MAX)
+        else {
+            self.reclaim_cancel();
+            return;
+        };
+        self.owner.input_nonce = nonce;
+        let request = ev_input::SessionBarrierRequest::new(nonce).unwrap();
+        let barrier = rt::rpc::call(
+            self.channel(Channel::InputBarrier),
+            request.encode(),
+            deadline(v5::resources::RPC_TICKS).min(cut),
+        )
+        .ok()
+        .and_then(|r| ev_input::SessionBarrierReply::decode(r).ok());
+        let Some(barrier) = barrier else {
+            self.reclaim_cancel();
+            return;
+        };
+        if now() >= cut {
+            self.reclaim_cancel();
+            return;
+        }
+        self.input.arm(barrier);
+        let d = self.reclaim.dialog.as_mut().unwrap();
+        let policy = self.policy.as_mut().unwrap();
+        match policy.trusted.attest_presented(
+            &mut policy.desktop,
+            d.challenge,
+            facts.scope(),
+            frame,
+            self.input.serial(barrier.sequence),
+        ) {
+            Ok(w) => {
+                d.witness = Some(w);
+                d.rearm = false;
+            }
+            Err(_) => self.reclaim_cancel(),
+        }
+    }
+    pub(super) fn reclaim_confirm(&mut self, serial: u32) {
+        let Some(mut d) = self.reclaim.dialog.take() else {
+            return;
+        };
+        if !d.drained || d.witness.is_none() {
+            self.reclaim.dialog = Some(d);
+            return;
+        }
+        if !self.reclaim_facts_current(d.facts, d.cut)
+            || self.grant.is_some()
+            || self.owner.pending.is_some()
+        {
+            self.reclaim.dialog = Some(d);
+            self.reclaim_cancel();
+            self.status = b"Reclaim scope changed; request a fresh decision";
+            return;
+        }
+        let policy = self.policy.as_mut().unwrap();
+        let effect = policy.trusted.attest_confirmation(
+            &mut policy.desktop,
+            d.witness.take().unwrap(),
+            d.facts.scope(),
+            self.input.serial(serial),
+            ConfirmationSource::Physical,
+        );
+        let Ok(effect) = effect else {
+            d.rearm = true;
+            self.reclaim.dialog = Some(d);
+            self.owner.dirty = true;
+            return;
+        };
+        let start = now();
+        let Some(cut) = start
+            .checked_add(v5::resources::FILE_TRANSACTION_TICKS)
+            .filter(|v| *v != u64::MAX)
+        else {
+            return;
+        };
+        let Ok(approval) = Approval::new(d.facts, effect, start, cut) else {
+            return;
+        };
+        self.reclaim.pending = Some(Pending {
+            approval,
+            phase: Phase::Retire(1),
+            reply: None,
+        });
+        self.reclaim.status =
+            b"Confirmed permanent removal: exact grants and storage ownership must settle";
+        self.owner.dirty = true;
+    }
+    pub(super) fn reclaim_tick(&mut self) -> bool {
+        if !self.reclaim.active() {
+            return false;
+        }
+        for _ in 0..32 {
+            if !self.receive() {
+                break;
+            }
+        }
+        self.app_data_flush();
+        if !self.reclaim.drained {
+            let cut = self.reclaim.drain_cut;
+            if now() >= cut {
+                self.reclaim_cancel();
+            } else if !self.outbox.has_pending() {
+                match self.inspector_self_shutdown(cut) {
+                    Ok(true) => {
+                        self.reclaim.drained = true;
+                        if let Some(dialog) = self.reclaim.dialog.as_mut() {
+                            dialog.drained = true;
+                        }
+                        self.owner.dirty = true;
+                    }
+                    Ok(false) => (),
+                    Err(_) => self.reclaim_cancel(),
+                }
+            }
+        }
+        if self.reclaim.pending.is_some() {
+            // The sole pending owner remains resident while helpers perform
+            // calls. No ordinary Root effect, grant or scene commit runs here.
+            let (phase, facts, cut) = self
+                .reclaim
+                .pending
+                .as_ref()
+                .map(|p| (p.phase, p.approval.facts(), p.approval.cut()))
+                .unwrap();
+            let live = self
+                .reclaim
+                .pending
+                .as_mut()
+                .unwrap()
+                .approval
+                .admit(now())
+                .is_ok();
+            if !live {
+                self.reclaim.pending.as_mut().unwrap().phase = Phase::Fenced;
+            } else if phase != Phase::Fenced {
+                let next = match phase {
+                    Phase::Retire(index) => match self.reclaim_retire_file(index, facts, cut) {
+                        Ok(true) => Some(if index == 2 {
+                            Phase::Purge
+                        } else {
+                            Phase::Retire(index + 1)
+                        }),
+                        Ok(false) => None,
+                        Err(_) => Some(Phase::Fenced),
+                    },
+                    Phase::Purge => {
+                        let result = self.workspace.purge_until(
+                            self.channel(Channel::RootWorkspaceControl),
+                            control::Command::Purge {
+                                token: self.reclaim.nonce(),
+                                dataset: facts.dataset,
+                                object: facts.entry.object,
+                                expected_revision: facts.entry.revision,
+                                namespace_revision: facts.namespace,
+                                name: facts.entry.name,
+                            },
+                            cut,
+                        );
+                        match result {
+                            Ok(reply) => {
+                                let success = reply.status == control::Status::Applied
+                                    && reply.receipt.is_some_and(|r| {
+                                        r.namespace_revision == facts.namespace + 1
+                                            && r.allocated_before.checked_sub(r.allocated_after)
+                                                == facts.released_bytes()
+                                    });
+                                self.reclaim.pending.as_mut().unwrap().reply = Some(reply);
+                                Some(if success {
+                                    Phase::Complete
+                                } else {
+                                    Phase::Fenced
+                                })
+                            }
+                            Err(_) => Some(Phase::Fenced),
+                        }
+                    }
+                    Phase::Complete | Phase::Fenced => None,
+                };
+                let p = self.reclaim.pending.as_mut().unwrap();
+                if let Some(next) = next {
+                    p.phase = next;
+                    self.owner.dirty = true;
+                }
+                if p.approval.admit(now()).is_err() {
+                    p.phase = Phase::Fenced;
+                }
+            }
+        }
+        if self
+            .reclaim
+            .pending
+            .as_ref()
+            .is_some_and(|p| p.phase == Phase::Fenced)
+        {
+            self.reclaim.status =
+                b"Permanent removal incomplete; exact accepted work and owners remain retained";
+        }
+        if self.owner.dirty && self.try_present_owner().is_err() {
+            if let Some(p) = self.reclaim.pending.as_mut() {
+                p.phase = Phase::Fenced;
+            } else {
+                self.reclaim_cancel();
+            }
+            self.owner.dirty = false;
+        }
+        if self
+            .reclaim
+            .pending
+            .as_ref()
+            .is_some_and(|p| p.phase == Phase::Complete)
+        {
+            let p = self.reclaim.pending.as_mut().unwrap();
+            if p.approval.admit(now()).is_err() {
+                p.phase = Phase::Fenced;
+            } else {
+                self.reclaim.pending = None;
+                self.status =
+                    b"Exact trashed object permanently removed; Restore ended; refresh Files";
+                self.owner.dirty = true;
+            }
+        }
+        let _ = rt::yield_now();
+        true
+    }
+}
