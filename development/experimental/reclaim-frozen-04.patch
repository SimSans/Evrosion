+++ b/services/workspace/src/purge_control.rs
@@ -0,0 +1,185 @@
+//! Exact Root-only purge codec. Descriptive CAS fields confer no authority.
+use super::*;
+use ev_userspace_contract::workspace::Name;
+
+pub(super) fn encode_request(b: &mut [u8; FRAME_BYTES], command: Command) -> Result<(), Error> {
+    let Command::Purge {
+        token: _,
+        dataset,
+        object,
+        expected_revision,
+        namespace_revision,
+        name,
+    } = command
+    else {
+        return Err(Error::Opcode);
+    };
+    if dataset == [0; 16]
+        || object.slot == 0
+        || object.validate().is_err()
+        || !finite(expected_revision)
+        || !finite(namespace_revision)
+    {
+        return Err(Error::Scope);
+    }
+    b[8] = 10;
+    b[40..56].copy_from_slice(&dataset);
+    b[56..58].copy_from_slice(&object.slot.to_le_bytes());
+    b[58..60].copy_from_slice(&(name.as_str().len() as u16).to_le_bytes());
+    put(b, 64, object.generation);
+    put(b, 72, expected_revision);
+    put(b, 80, namespace_revision);
+    b[128..128 + name.as_str().len()].copy_from_slice(name.as_str().as_bytes());
+    Ok(())
+}
+pub(super) fn decode_command(b: &[u8]) -> Result<Command, Error> {
+    let length = u16::from_le_bytes(b[58..60].try_into().unwrap()) as usize;
+    if length > 96 {
+        return Err(Error::Scope);
+    }
+    Ok(Command::Purge {
+        token: word(b, 32),
+        dataset: b[40..56].try_into().unwrap(),
+        object: ObjectId {
+            slot: u16::from_le_bytes(b[56..58].try_into().unwrap()),
+            generation: word(b, 64),
+        },
+        expected_revision: word(b, 72),
+        namespace_revision: word(b, 80),
+        name: Name::new(&b[128..128 + length]).map_err(|_| Error::Scope)?,
+    })
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PurgeReceipt {
+    pub operation: u64,
+    pub sequence: u64,
+    pub namespace_revision: u64,
+    pub allocated_before: u64,
+    pub allocated_after: u64,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PurgeResponse {
+    pub request_id: u64,
+    pub token: u64,
+    pub status: Status,
+    pub dataset: [u8; 16],
+    pub object: ObjectId,
+    pub expected_revision: u64,
+    /// Exact pre-purge namespace CAS; receipt names the resulting namespace.
+    pub namespace_revision: u64,
+    pub name: Name,
+    pub receipt: Option<PurgeReceipt>,
+}
+impl PurgeResponse {
+    pub fn for_request(
+        request: Request,
+        status: Status,
+        receipt: Option<PurgeReceipt>,
+    ) -> Result<Self, Error> {
+        let Command::Purge {
+            token,
+            dataset,
+            object,
+            expected_revision,
+            namespace_revision,
+            name,
+        } = request.command
+        else {
+            return Err(Error::Opcode);
+        };
+        Ok(Self {
+            request_id: request.request_id,
+            token,
+            status,
+            dataset,
+            object,
+            expected_revision,
+            namespace_revision,
+            name,
+            receipt,
+        })
+    }
+    pub fn encode(self) -> Result<[u8; FRAME_BYTES], Error> {
+        let request = Request {
+            request_id: self.request_id,
+            deadline: Deadline::new(1).map_err(|_| Error::Identity)?,
+            command: Command::Purge {
+                token: self.token,
+                dataset: self.dataset,
+                object: self.object,
+                expected_revision: self.expected_revision,
+                namespace_revision: self.namespace_revision,
+                name: self.name,
+            },
+        };
+        let mut b = request.encode()?;
+        b[..8].copy_from_slice(b"EVWPGA01");
+        b[8] = self.status as u8;
+        put(&mut b, 24, 0);
+        if (self.status == Status::Applied) != self.receipt.is_some() {
+            return Err(Error::Scope);
+        }
+        if let Some(receipt) = self.receipt {
+            if !finite(receipt.operation)
+                || !finite(receipt.sequence)
+                || Some(receipt.namespace_revision) != self.namespace_revision.checked_add(1)
+                || receipt.allocated_after > receipt.allocated_before
+            {
+                return Err(Error::Scope);
+            }
+            put(&mut b, 88, receipt.namespace_revision);
+            put(&mut b, 96, receipt.operation);
+            put(&mut b, 104, receipt.sequence);
+            put(&mut b, 112, receipt.allocated_before);
+            put(&mut b, 120, receipt.allocated_after);
+        }
+        Ok(b)
+    }
+    pub fn decode(b: &[u8]) -> Result<Self, Error> {
+        if b.len() != FRAME_BYTES {
+            return Err(Error::Length);
+        }
+        if &b[..8] != b"EVWPGA01" {
+            return Err(Error::Magic);
+        }
+        let status = match b[8] {
+            0 => Status::Applied,
+            1 => Status::Denied,
+            2 => Status::Stale,
+            3 => Status::Busy,
+            4 => Status::Malformed,
+            5 => Status::Storage,
+            6 => Status::Scope,
+            7 => Status::Uncertain,
+            8 => Status::Unavailable,
+            9 => Status::Deadline,
+            _ => return Err(Error::Opcode),
+        };
+        let request = Request {
+            request_id: word(b, 16),
+            deadline: Deadline::new(1).map_err(|_| Error::Identity)?,
+            command: decode_command(b)?,
+        };
+        let receipt = (status == Status::Applied).then_some(PurgeReceipt {
+            operation: word(b, 96),
+            sequence: word(b, 104),
+            namespace_revision: word(b, 88),
+            allocated_before: word(b, 112),
+            allocated_after: word(b, 120),
+        });
+        let value = Self::for_request(request, status, receipt)?;
+        if value.encode()?.as_slice() != b {
+            return Err(Error::Reserved);
+        }
+        Ok(value)
+    }
+    pub fn matches(self, request: Request) -> Result<Self, Error> {
+        if self.request_id != request.request_id
+            || Self::for_request(request, self.status, self.receipt)? != self
+        {
+            return Err(Error::Correlation);
+        }
+        self.encode()?;
+        Ok(self)
+    }
+}
