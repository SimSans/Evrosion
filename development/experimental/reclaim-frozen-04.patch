+    let replacement = g
+        .store
+        .create(
+            g.store.next_operation().unwrap(),
+            g.namespace_revision(),
+            ObjectId::ROOT,
+            Name::new("replacement.txt").unwrap(),
+            Kind::File,
+            DEADLINE,
+        )
+        .unwrap()
+        .object;
+    assert_eq!(replacement.slot, object.slot);
+    assert_eq!(replacement.generation, object.generation + 1);
+    assert!(g.owner_metadata(object).is_err());
+    assert!(g.bind(binding(object, 72, Rights::ReadOnly)).is_err());
+    drop(g);
+    let mut cold_ss = Box::new(StoreScratch::empty());
+    let cold = Dataset::open(Memory::image(memory.snapshot()), &mut cold_ss, DEADLINE)
+        .unwrap_or_else(|e| panic!("{:?}", e.error));
+    assert!(cold.metadata(object).is_err());
+    assert_eq!(cold.name(replacement).unwrap(), "replacement.txt");
+    assert!(!cold.needs_mirror_recovery());
+}
