+fn purge_request(g: &Gateway<'_, '_, Memory>, object: ObjectId) -> control::Request {
+    control::Request {
+        request_id: 91,
+        deadline: Deadline::new(DEADLINE).unwrap(),
+        command: Command::Purge {
+            token: 71,
+            dataset: g.dataset_id(),
+            object: ns::ObjectId {
+                slot: object.slot,
+                generation: object.generation,
+            },
+            expected_revision: g.owner_metadata(object).unwrap().revision,
+            namespace_revision: g.namespace_revision(),
+            name: ns::Name::new(g.owner_name(object).unwrap().as_bytes()).unwrap(),
+        },
+    }
+}
+fn decoded(request: control::Request, dispatch: PurgeDispatch) -> PurgeResponse {
+    let PurgeDispatch::Complete { frame } = dispatch else {
+        panic!("retained")
+    };
+    PurgeResponse::decode(&frame)
+        .unwrap()
+        .matches(request)
+        .unwrap()
+}
+fn trash(g: &mut Gateway<'_, '_, Memory>, object: ObjectId) {
+    g.store
+        .trash(
+            g.store.next_operation().unwrap(),
+            g.store.namespace_revision(),
+            object,
+            DEADLINE,
+        )
+        .unwrap();
+}
+fn commit_text(g: &mut Gateway<'_, '_, Memory>, object: ObjectId) {
+    let text = b"exact reclaim bytes";
+    let stage = g
+        .store
+        .begin_write(
+            g.store.next_operation().unwrap(),
+            object,
+            1,
+            text.len() as u64,
+            hash(text),
+            DEADLINE,
+        )
+        .unwrap()
+        .stage;
+    g.store
+        .write_chunk(g.store.next_operation().unwrap(), stage, 0, text, DEADLINE)
+        .unwrap();
+    g.store
+        .commit(g.store.next_operation().unwrap(), stage, DEADLINE)
+        .unwrap();
