--- /dev/null
+++ b/services/workspace-root/src/reclaim.rs
@@ -0,0 +1,189 @@
+//! Exact single-object irreversible intent. This model supplies neither a
+//! Kernel retirement receipt nor permission to reclaim storage by itself.
+use crate::{
+    Identity,
+    development::{Cut, Error},
+    policy::owner,
+};
+use ev_userspace_contract::workspace::{Entry, EntryState};
+use ev_workspace_shell::{ActionScope, ActionTarget, Effect, ProtectedKind, Rights};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Facts {
+    pub root: Identity,
+    pub dataset: [u8; 16],
+    pub namespace: u64,
+    pub entry: Entry,
+}
+impl Facts {
+    pub fn valid(self) -> bool {
+        self.root.valid()
+            && self.dataset != [0; 16]
+            && !matches!(self.namespace, 0 | u64::MAX)
+            && self.entry.object.slot != 0
+            && self.entry.object.validate().is_ok()
+            && !matches!(self.entry.revision, 0 | u64::MAX)
+            && self.entry.state == EntryState::Trashed
+    }
+    pub fn scope(self) -> ActionScope {
+        ActionScope {
+            kind: ProtectedKind::Reclaim,
+            requester: owner(self.root),
+            target: ActionTarget::Object {
+                dataset: self.dataset,
+                slot: self.entry.object.slot,
+                generation: self.entry.object.generation,
+                revision: self.entry.revision,
+            },
+            rights: Rights::REMOVE,
+        }
+    }
+    pub fn released_bytes(self) -> Option<u64> {
+        u64::from(self.entry.size)
+            .checked_add(4095)
+            .map(|n| n / 4096 * 4096)
+    }
+}
+pub struct Approval {
+    facts: Facts,
+    nonce: u64,
+    original: u64,
+    clock: Cut,
+}
+impl Approval {
+    pub fn new(facts: Facts, effect: Effect, now: u64, cut: u64) -> Result<Self, Error> {
+        if !facts.valid()
+            || effect.scope() != facts.scope()
+            || matches!(effect.nonce(), 0 | u64::MAX)
+        {
+            return Err(Error::Effect);
+        }
+        Ok(Self {
+            facts,
+            nonce: effect.nonce(),
+            original: cut,
+            clock: Cut::new(now, cut)?,
+        })
+    }
+    pub const fn facts(&self) -> Facts {
+        self.facts
+    }
+    pub const fn nonce(&self) -> u64 {
+        self.nonce
+    }
+    pub const fn cut(&self) -> u64 {
+        self.original
+    }
+    pub fn admit(&mut self, now: u64) -> Result<(), Error> {
+        self.clock.admit(now)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ev_userspace_contract::workspace::{Kind, Name, ObjectId};
+    fn facts() -> Facts {
+        Facts {
+            root: Identity {
+                process: 1,
+                thread: 2,
+                registered: 3,
+            },
+            dataset: [84; 16],
+            namespace: 4,
+            entry: Entry {
+                object: ObjectId {
+                    slot: 1,
+                    generation: 2,
+                },
+                parent: ObjectId {
+                    slot: 0,
+                    generation: 1,
+                },
+                kind: Kind::File,
+                state: EntryState::Trashed,
+                revision: 3,
+                size: 4097,
+                name: Name::new(b"removed").unwrap(),
+            },
+        }
+    }
+    fn effect(f: Facts) -> Effect {
+        let mut p = crate::policy::Policy::new(
+            Identity {
+                process: 5,
+                thread: 6,
+                registered: 3,
+            },
+            f.root,
+        )
+        .unwrap();
+        let scope = f.scope();
+        let a = p.trusted.attest_attention(&mut p.desktop, 10).unwrap();
+        let c = p.trusted.challenge(&mut p.desktop, a, scope).unwrap();
+        let w = p
+            .trusted
+            .attest_presented(&mut p.desktop, c, scope, 20, 11)
+            .unwrap();
+        p.trusted
+            .attest_confirmation(
+                &mut p.desktop,
+                w,
+                scope,
+                12,
+                ev_workspace_shell::ConfirmationSource::Physical,
+            )
+            .unwrap()
+    }
+    #[test]
+    fn exact_effect_and_one_original_cut_survive_expiry_or_clock_reversal() {
+        let f = facts();
+        let mut changed = f;
+        changed.entry.object.generation += 1;
+        assert!(matches!(
+            Approval::new(changed, effect(f), 100, 8000),
+            Err(Error::Effect)
+        ));
+        let mut a = Approval::new(f, effect(f), 100, 8000).unwrap();
+        assert_eq!(a.facts(), f);
+        assert_eq!(a.cut(), 8000);
+        assert!(a.admit(7999).is_ok());
+        assert_eq!(a.admit(8000), Err(Error::Deadline));
+        assert_eq!(a.admit(200), Err(Error::Deadline));
+        let mut a = Approval::new(f, effect(f), 100, 8000).unwrap();
+        assert!(a.admit(150).is_ok());
+        assert_eq!(a.admit(149), Err(Error::Deadline));
+        assert_eq!(a.admit(151), Err(Error::Deadline));
+    }
+    #[test]
+    fn permanent_scope_is_exact_and_never_targets_live_or_root_objects() {
+        let f = facts();
+        assert!(f.valid());
+        assert_eq!(f.released_bytes(), Some(8192));
+        let mut changed = f;
+        changed.entry.state = EntryState::Live;
+        assert!(!changed.valid());
+        changed = f;
+        changed.entry.object = ObjectId {
+            slot: 0,
+            generation: 1,
+        };
+        assert!(!changed.valid());
+        changed = f;
+        changed.dataset = [0; 16];
+        assert!(!changed.valid());
+        changed = f;
+        changed.entry.object.generation += 1;
+        assert_ne!(changed.scope(), f.scope());
+        changed = f;
+        changed.entry.revision += 1;
+        assert_ne!(changed.scope(), f.scope());
+        changed = f;
+        changed.namespace += 1;
+        assert_ne!(changed, f);
+        changed = f;
+        changed.entry.name = Name::new(b"other").unwrap();
+        assert_ne!(changed, f);
+    }
+}
