--- /dev/null
+++ b/services/workspace/src/admin.rs
@@ -0,0 +1,226 @@
+//! Trusted Root-only single-object reclamation. Wire IDs and ReclaimFence are
+//! descriptive integration assertions, never evidence of actual grant retirement.
+//! Only the native role16 adapter may invoke this after authenticating Root.
+use crate::control::{self, Command, PurgeReceipt, PurgeResponse, Status};
+use crate::*;
+use ev_workspace_store::ReclaimFence;
+
+// One exact bounded control frame; native stack census includes this result.
+#[allow(clippy::large_enum_variant)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PurgeDispatch {
+    Complete { frame: [u8; 256] },
+    Retained,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PurgePending {
+    pub request: control::Request,
+    pub fingerprint: [u8; 32],
+    pub operation: OperationId,
+    pub allocated_before: u64,
+}
+#[derive(Clone, Copy)]
+pub(crate) struct State {
+    pending: PurgePending,
+    response: Option<PurgeResponse>,
+}
+fn refusal(request: control::Request, status: Status) -> PurgeDispatch {
+    // Malformed commands have no valid purge acknowledgement. Native framing
+    // rejects them before calling this trusted method; no storage was touched.
+    let frame = PurgeResponse::for_request(request, status, None)
+        .and_then(PurgeResponse::encode)
+        .unwrap_or([0; 256]);
+    PurgeDispatch::Complete { frame }
+}
+impl<D: SectorIo> Gateway<'_, '_, D> {
+    pub fn purge_pending(&self) -> Option<PurgePending> {
+        self.purge
+            .filter(|p| p.response.is_none())
+            .map(|p| p.pending)
+    }
+    /// Existing authenticated Root control route only. Native retains its
+    /// actual serving origin/receiver/window through this call and quarantines
+    /// Retained without reply or frame overwrite. No general namespace opcode.
+    pub fn purge(
+        &mut self,
+        request: control::Request,
+        now: u64,
+        legacy_fenced: bool,
+    ) -> PurgeDispatch {
+        let Command::Purge {
+            token,
+            dataset,
+            object,
+            expected_revision,
+            namespace_revision,
+            name,
+        } = request.command
+        else {
+            return refusal(request, Status::Malformed);
+        };
+        let frame = match request.encode() {
+            Ok(frame) => frame,
+            Err(_) => return refusal(request, Status::Malformed),
+        };
+        let fingerprint = hash(&frame);
+        if let Some(previous) = self.purge {
+            if previous.response.is_none() {
+                return PurgeDispatch::Retained;
+            }
+            if request.request_id <= previous.pending.request.request_id {
+                return if previous.pending.request == request
+                    && previous.pending.fingerprint == fingerprint
+                {
+                    PurgeDispatch::Complete {
+                        frame: previous.response.unwrap().encode().unwrap(),
+                    }
+                } else {
+                    refusal(request, Status::Stale)
+                };
+            }
+        }
+        if !request.deadline.is_live(now) {
+            return refusal(request, Status::Deadline);
+        }
+        if self.seal.is_some()
+            || self.retirement_fenced
+            || legacy_fenced
+            || self.store.is_poisoned()
+            || self.store.needs_mirror_recovery()
+        {
+            return refusal(request, Status::Storage);
+        }
+        if self.pending.is_some()
+            || self.commit.is_some()
+            || self.namespace.pending().is_some()
+            || self.transfer.is_some()
+            || self.prepared.is_some()
+        {
+            return refusal(request, Status::Busy);
+        }
+        match self.store.pending_stage() {
+            Ok(None) => (),
+            Ok(Some(_)) => return refusal(request, Status::Busy),
+            Err(_) => return refusal(request, Status::Storage),
+        }
+        if self.store.dataset_id().bytes() != dataset
+            || self.store.namespace_revision() != namespace_revision
+        {
+            return refusal(request, Status::Stale);
+        }
+        let object = ObjectId {
+            slot: object.slot,
+            generation: object.generation,
+        };
+        if object == ObjectId::ROOT {
+            return refusal(request, Status::Scope);
+        }
+        let metadata = match self.store.metadata(object) {
+            Ok(m) => m,
+            Err(_) => return refusal(request, Status::Stale),
+        };
+        if metadata.revision != expected_revision
+            || self.store.name(object).ok() != Some(name.as_str())
+        {
+            return refusal(request, Status::Stale);
+        }
+        if !metadata.directly_trashed {
+            return refusal(request, Status::Scope);
+        }
+        // Presence is the independent guard: revoked rows still block until
+        // exact explicit service reconciliation actually removes the row.
+        if self
+            .routes
+            .iter()
+            .flatten()
+            .any(|r| r.binding.object == object)
+            || self.namespace.references(object)
+        {
+            return refusal(request, Status::Busy);
+        }
+        if metadata.kind == Kind::Directory {
+            match self.store.list(object, 0, true) {
+                Ok(None) => (),
+                Ok(Some(_)) => return refusal(request, Status::Busy),
+                Err(_) => return refusal(request, Status::Storage),
+            }
+        }
+        let allocated_before = match self.store.allocated_bytes() {
+            Ok(n) => n,
+            Err(_) => return refusal(request, Status::Storage),
+        };
+        let operation = match self.store.next_operation() {
+            Ok(op) => op,
+            Err(_) => return refusal(request, Status::Storage),
+        };
+        // Final cached CAS/eligibility checks and exclusive ownership precede
+        // the first possible I/O. The one owner cannot interleave another call.
+        self.purge = Some(State {
+            pending: PurgePending {
+                request,
+                fingerprint,
+                operation,
+                allocated_before,
+            },
+            response: None,
+        });
+        self.retirement_fenced = true;
+        let result = self.store.purge(
+            operation,
+            ReclaimFence {
+                object,
+                namespace_revision,
+                authority_epoch: token,
+            },
+            request.deadline.tick(),
+        );
+        let receipt = match result {
+            Ok(receipt) => receipt,
+            Err(_) => return PurgeDispatch::Retained,
+        };
+        let allocated_after = match self.store.allocated_bytes() {
+            Ok(n) => n,
+            Err(_) => return PurgeDispatch::Retained,
+        };
+        let reclaimed = if metadata.kind == Kind::File {
+            metadata.length.div_ceil(CHUNK_BYTES as u64) * CHUNK_BYTES as u64
+        } else {
+            0
+        };
+        if receipt.kind != ReceiptKind::Purged
+            || receipt.operation != operation
+            || receipt.object != object
+            || receipt.object_revision != expected_revision
+            || receipt.namespace_revision != namespace_revision.checked_add(1).unwrap_or(0)
+            || receipt.replayed
+            || self.store.namespace_revision() != receipt.namespace_revision
+            || self.store.last_receipt().ok() != Some(Some(receipt))
+            || self.store.metadata(object).is_ok()
+            || self.store.is_poisoned()
+            || self.store.needs_mirror_recovery()
+            || self.store.pending_stage().ok() != Some(None)
+            || allocated_before.checked_sub(allocated_after) != Some(reclaimed)
+        {
+            return PurgeDispatch::Retained;
+        }
+        let response = PurgeResponse::for_request(
+            request,
+            Status::Applied,
+            Some(PurgeReceipt {
+                operation: operation.get(),
+                sequence: receipt.sequence,
+                namespace_revision: receipt.namespace_revision,
+                allocated_before,
+                allocated_after,
+            }),
+        )
+        .unwrap();
+        let frame = match response.encode() {
+            Ok(frame) => frame,
+            Err(_) => return PurgeDispatch::Retained,
+        };
+        self.purge.as_mut().unwrap().response = Some(response);
+        self.retirement_fenced = false;
+        PurgeDispatch::Complete { frame }
+    }
+}
