+#[test]
+fn interrupted_publication_retains_exact_request_op_and_cut_without_ack_or_retry() {
+    let memory = Memory::new();
+    let mut ss = Box::new(StoreScratch::empty());
+    let mut gs = Box::new(Scratch::empty());
+    let (store, object, _) = dataset(memory.clone(), &mut ss);
+    let mut g = Gateway::new(store, &mut gs);
+    commit_text(&mut g, object);
+    trash(&mut g, object);
+    let request = purge_request(&g, object);
+    memory.fail_next_flush_after_persist();
+    assert_eq!(g.purge(request, 1, false), PurgeDispatch::Retained);
+    let pending = g.purge_pending().unwrap();
+    assert_eq!(pending.request, request);
+    assert_eq!(pending.fingerprint, hash(&request.encode().unwrap()));
+    assert!(g.retirement_fenced);
+    let before = memory.counts();
+    assert_eq!(g.purge(request, 2, false), PurgeDispatch::Retained);
+    assert_eq!(
+        g.purge(
+            control::Request {
+                request_id: 92,
+                ..request
+            },
+            2,
+            false
+        ),
+        PurgeDispatch::Retained
+    );
+    assert_eq!(g.purge_pending(), Some(pending));
+    assert_eq!(memory.counts(), before);
+    assert_eq!(
+        g.bind(binding(object, 73, Rights::ReadOnly)),
+        Err(BindError::StorageFenced)
+    );
+    assert_eq!(memory.counts(), before);
+}
