+fn inspect_namespace(path: &Path, evidence: &Path, initial: bool) -> Result<bool, String> {
+    use ev_workspace_store::{Dataset, Kind, ObjectId, Scratch};
+    use sha2::{Digest, Sha256};
+    let region = Region {
+        file: File::open(path).map_err(|e| e.to_string())?,
+        reads: 0,
+        writes: 0,
+        flushes: 0,
+        origin: Instant::now(),
+    };
+    let mut scratch = Box::new(Scratch::empty());
+    let mut ds = Dataset::open(region, &mut scratch, 60_000)
+        .map_err(|e| format!("namespace cold open:{:?}", e.error))?;
+    let folder_id = ObjectId {
+        slot: 1,
+        generation: 1,
+    };
+    let note_id = ObjectId {
+        slot: 2,
+        generation: 1,
+    };
+    let mut rows = Vec::new();
+    let mut folder = false;
+    let mut note = false;
+    let mut count = 0;
+    for directory in [ObjectId::ROOT, folder_id] {
+        let mut cursor = 0;
+        for _ in 0..=256 {
+            let Some(m) = ds
+                .list(directory, cursor, true)
+                .map_err(|e| format!("namespace cold list:{e:?}"))?
+            else {
+                break;
+            };
+            cursor = m.id.slot;
+            count += 1;
+            let name = ds
+                .name(m.id)
+                .map_err(|e| format!("namespace name:{e:?}"))?
+                .to_owned();
+            let mut text = None;
+            let mut actual_hash = None;
+            if m.id == folder_id
+                && m.kind == Kind::Directory
+                && m.parent == ObjectId::ROOT
+                && name == "folder1"
+                && m.revision == 1
+                && !m.directly_trashed
+            {
+                folder = true;
+            }
+            if m.kind == Kind::File {
+                if m.length > 4096 {
+                    return Err("namespace file exceeds bounded exact15B fixture".into());
+                }
+                let mut bytes = vec![0; m.length as usize];
+                let mut offset = 0;
+                while offset < bytes.len() {
+                    let n = ds
+                        .read(
+                            m.id,
+                            m.revision,
+                            offset as u64,
+                            &mut bytes[offset..],
+                            60_000,
+                        )
+                        .map_err(|e| format!("namespace cold read:{e:?}"))?;
+                    if n == 0 {
+                        return Err("namespace cold read made no progress".into());
+                    }
+                    offset += n;
+                }
+                let hash: [u8; 32] = Sha256::digest(&bytes).into();
+                actual_hash = Some(bundle::hex(&hash));
+                note = m.id == note_id
+                    && m.parent == if initial { ObjectId::ROOT } else { folder_id }
+                    && name == if initial { "note1" } else { "note24" }
+                    && m.revision == 2
+                    && m.length == 15
+                    && bytes == super::scenario::TEXT.as_bytes()
+                    && hash == m.sha256
+                    && !m.directly_trashed;
+                text = String::from_utf8(bytes).ok();
+            }
+            rows.push(serde_json::json!({"name":name,"slot":m.id.slot,"generation":m.id.generation,"parent_slot":m.parent.slot,"parent_generation":m.parent.generation,"kind":format!("{:?}",m.kind),"revision":m.revision,"length":m.length,"trashed":m.directly_trashed,"metadata_sha256":bundle::hex(&m.sha256),"independently_read_sha256":actual_hash,"bounded_utf8":text}));
+        }
+    }
+    let stage = ds
+        .pending_stage()
+        .map_err(|e| format!("namespace stage:{e:?}"))?;
+    let receipt = ds
+        .last_receipt()
+        .map_err(|e| format!("namespace receipt:{e:?}"))?;
+    let confirmed = folder
+        && note
+        && count == 2
+        && ds.dataset_id().bytes() == [0x84; 16]
+        && ds.namespace_revision() == if initial { 4 } else { 8 }
+        && stage.is_none()
+        && !ds.needs_mirror_recovery();
+    bundle::write_json_new(
+        evidence,
+        &serde_json::json!({"schema":1,"scope":"OS read-only bounded real Dataset after direct owned VM wait, or before guest launch when initial=true; no host repair or mutation","initial":initial,"namespace_revision":ds.namespace_revision(),"dataset":bundle::hex(&ds.dataset_id().bytes()),"needs_mirror_recovery":ds.needs_mirror_recovery(),"pending_stage":format!("{stage:?}"),"latest_retained_receipt":format!("{receipt:?}"),"rows":rows,"stable_folder_slot1_gen1_rev1":folder,"stable_note_slot2_gen1_rev2_exact15B_and_expected_location":note,"entry_count":count,"confirmed":confirmed}),
     )?;
     Ok(confirmed)
 }
