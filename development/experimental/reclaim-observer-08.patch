+fn reclaim_outside_digest(path: &Path) -> Result<serde_json::Value, String> {
+    use sha2::{Digest, Sha256};
+    let mut file = File::open(path).map_err(|e| e.to_string())?;
+    let length = file.metadata().map_err(|e| e.to_string())?.len();
+    if length != 96 * 1024 * 1024 {
+        return Err("reclaim outside-region oracle requires exact96MiB".into());
+    }
+    let start = 16_384 * 512;
+    let end = (16_384 + ev_workspace_store::REQUIRED_SECTORS) * 512;
+    if end != 168_706 * 512 {
+        return Err("unexpected Workspace physical range".into());
+    }
+    let mut range = |at: u64, mut bytes: u64| -> Result<String, String> {
+        file.seek(SeekFrom::Start(at)).map_err(|e| e.to_string())?;
+        let mut h = Sha256::new();
+        let mut buffer = [0; 65536];
+        while bytes > 0 {
+            let n = bytes.min(buffer.len() as u64) as usize;
+            file.read_exact(&mut buffer[..n])
+                .map_err(|e| e.to_string())?;
+            h.update(&buffer[..n]);
+            bytes -= n as u64;
+        }
+        let digest: [u8; 32] = h.finalize().into();
+        Ok(bundle::hex(&digest))
+    };
+    Ok(
+        serde_json::json!({"scope":"Every byte outside Workspace physical sectors[16384,168706); readonly observation, no repair","prefix_bytes":start,"prefix_sha256":range(0,start)?,"tail_first_sector":168706,"tail_bytes":length-end,"tail_sha256":range(end,length-end)?}),
+    )
+}
+pub(super) fn reclaim_snapshot(
+    path: &Path,
+    directory: &Path,
+    phase: &'static str,
+) -> Result<serde_json::Value, String> {
+    let snapshot = directory.join(format!("reclaim-{phase}.raw"));
+    let evidence = directory.join(format!("reclaim-{phase}.json"));
+    let before = fs::metadata(path).map_err(|e| e.to_string())?;
+    let mut input = File::open(path).map_err(|e| e.to_string())?;
+    let mut output = OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(&snapshot)
+        .map_err(|e| e.to_string())?;
+    let copied = std::io::copy(&mut input, &mut output).map_err(|e| e.to_string())?;
+    output.sync_all().map_err(|e| e.to_string())?;
+    let after = fs::metadata(path).map_err(|e| e.to_string())?;
+    let stable = before.len() == 96 * 1024 * 1024
+        && copied == before.len()
+        && before.modified().ok() == after.modified().ok()
+        && before.len() == after.len();
+    bundle::write_json_new(
+        &directory.join(format!("reclaim-{phase}-capture.json")),
+        &serde_json::json!({"scope":"One bounded OS-read-only capture of actual owned VM data after stable public UI gates; no host repair or native quiescence claim","source":path,"snapshot":snapshot,"bytes":copied,"source_metadata_stable_during_capture":stable,"snapshot_sha256":build::hash_file(&snapshot)?}),
+    )?;
+    if !stable {
+        return Err(
+            "actual reclaim snapshot overlapped a real data write; raw capture retained, no retry"
+                .into(),
+        );
+    }
+    if !reclaim_inspect(&snapshot, &evidence, phase)? {
+        return Err(format!(
+            "actual reclaim {phase} byte/receipt oracle failed; raw capture retained"
+        ));
+    }
+    if phase == "cancel"
+        && build::hash_file(&snapshot)?
+            != build::hash_file(&directory.join("reclaim-before-purge.raw"))?
+    {
+        return Err("actual cancel changed captured data; both exact captures retained".into());
+    }
+    Ok(
+        serde_json::json!({"phase":phase,"raw_snapshot":snapshot,"oracle":evidence,"oracle_confirmed":true,"whole_disk_cancel_unchanged":phase=="cancel"}),
+    )
+}
+fn reclaim_inspect(path: &Path, evidence: &Path, phase: &str) -> Result<bool, String> {
+    use ev_workspace_store::{Dataset, Kind, ObjectId, ReceiptKind, Scratch};
+    use sha2::{Digest, Sha256};
+    let region = Region {
+        file: File::open(path).map_err(|e| e.to_string())?,
+        reads: 0,
+        writes: 0,
+        flushes: 0,
+        origin: Instant::now(),
+    };
+    let mut scratch = Box::new(Scratch::empty());
+    let mut ds = Dataset::open(region, &mut scratch, 60_000)
+        .map_err(|e| format!("reclaim readonly open:{:?}", e.error))?;
+    let old = ObjectId {
+        slot: 2,
+        generation: 1,
+    };
+    let new = ObjectId {
+        slot: 2,
+        generation: 2,
+    };
+    let folder = ObjectId {
+        slot: 1,
+        generation: 1,
+    };
+    let purged = phase == "purged";
+    let saved = phase == "saved";
+    let seed = phase == "seed";
+    let trashed = matches!(phase, "before-purge" | "cancel");
+    let mut rows = Vec::new();
+    let (mut folder_ok, mut old_ok, mut new_ok, mut keep_ok) = (false, false, false, false);
+    let mut cursor = 0;
+    for _ in 0..=256 {
+        let Some(m) = ds
+            .list(ObjectId::ROOT, cursor, true)
+            .map_err(|e| format!("reclaim list:{e:?}"))?
+        else {
+            break;
+        };
+        cursor = m.id.slot;
+        let name = ds
+            .name(m.id)
+            .map_err(|e| format!("reclaim name:{e:?}"))?
+            .to_owned();
+        let mut text = None;
+        let mut digest = None;
+        if m.kind == Kind::File {
+            if m.length > 64 {
+                return Err("reclaim exact fixture file exceeded64B".into());
+            }
+            let mut bytes = vec![0; m.length as usize];
+            let mut offset = 0;
+            while offset < bytes.len() {
+                let n = ds
+                    .read(
+                        m.id,
+                        m.revision,
+                        offset as u64,
+                        &mut bytes[offset..],
+                        60_000,
+                    )
+                    .map_err(|e| format!("reclaim exact bytes:{e:?}"))?;
+                if n == 0 {
+                    return Err("reclaim read made no progress".into());
+                }
+                offset += n;
+            }
+            let h: [u8; 32] = Sha256::digest(&bytes).into();
+            if h != m.sha256 {
+                return Err("reclaim metadata/whole-file digest mismatch".into());
+            }
+            digest = Some(bundle::hex(&h));
+            old_ok |= m.id == old
+                && name == "note1"
+                && m.revision == 2
+                && m.directly_trashed == trashed
+                && bytes == b"hello workspace";
+            new_ok |= m.id == new
+                && name == "note1"
+                && m.revision == 2
+                && !m.directly_trashed
+                && bytes == b"fresh object bytes";
+            keep_ok |=
+                m.id == (ObjectId {
+                    slot: 3,
+                    generation: 1,
+                }) && name == "keep24"
+                    && m.revision == 2
+                    && !m.directly_trashed
+                    && bytes == b"unrelated stays";
+            text = String::from_utf8(bytes).ok();
+        } else {
+            folder_ok |= m.id == folder
+                && name == "folder1"
+                && m.revision == 1
+                && !m.directly_trashed
+                && ds.list(folder, 0, true).ok() == Some(None);
+        }
+        rows.push(serde_json::json!({"slot":m.id.slot,"generation":m.id.generation,"parent_slot":m.parent.slot,"parent_generation":m.parent.generation,"name":name,"kind":format!("{:?}",m.kind),"revision":m.revision,"trashed":m.directly_trashed,"length":m.length,"sha256":digest,"exact_utf8":text}));
+    }
+    let namespace = ds.namespace_revision();
+    let allocated = ds
+        .allocated_bytes()
+        .map_err(|e| format!("reclaim allocation:{e:?}"))?;
+    let stage = ds
+        .pending_stage()
+        .map_err(|e| format!("reclaim stage:{e:?}"))?;
+    let mirror = ds.needs_mirror_recovery();
+    let receipt = ds
+        .last_receipt()
+        .map_err(|e| format!("reclaim receipt:{e:?}"))?;
+    let old_metadata_error = ds.metadata(old).err();
+    let old_metadata_failed = matches!(
+        &old_metadata_error,
+        Some(ev_workspace_store::Error::InvalidObject | ev_workspace_store::Error::StaleObject)
+    );
+    let mut probe = [0; 32];
+    let old_read_error = ds.read(old, 2, 0, &mut probe, 60_000).err();
+    let old_read_failed = matches!(
+        &old_read_error,
+        Some(ev_workspace_store::Error::InvalidObject | ev_workspace_store::Error::StaleObject)
+    );
+    let expected_namespace = if seed {
+        4
+    } else if trashed {
+        7
+    } else if purged {
+        8
+    } else {
+        10
+    };
+    let expected_allocated = if seed || purged { 4096 } else { 8192 };
+    let expected_kind = if purged {
