+    } else if trashed {
+        old_ok && keep_ok && rows.len() == 3
+    } else if purged {
+        !old_ok && keep_ok && old_metadata_failed && old_read_failed && rows.len() == 2
+    } else {
+        saved && new_ok && keep_ok && old_metadata_failed && old_read_failed && rows.len() == 3
+    };
+    let confirmed = folder_ok
+        && ds.dataset_id().bytes() == [0x84; 16]
+        && namespace == expected_namespace
+        && allocated == expected_allocated
+        && stage.is_none()
+        && !mirror
+        && expected_receipt
+        && shape;
+    let dataset = bundle::hex(&ds.dataset_id().bytes());
+    let receipt_record=receipt.map(|r|serde_json::json!({"kind":format!("{:?}",r.kind),"operation":r.operation.get(),"sequence":r.sequence,"object_slot":r.object.slot,"object_generation":r.object.generation,"object_revision":r.object_revision,"namespace_revision":r.namespace_revision,"stage":r.stage,"bytes":r.bytes,"replayed":r.replayed}));
