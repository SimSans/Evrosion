@@ -0,0 +1,305 @@
+//! Diagnostic-only fixed prefix of actual selected DisplayPresent credits.
+//! Never consulted by admission, scheduling, timeout, delivery or reply logic.
+use core::fmt::{self, Write};
+pub const ACTORS: usize = 13;
+pub const PER_ACTOR: usize = 4;
+pub const CAPACITY: usize = ACTORS * PER_ACTOR;
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Row {
+    pub caller: usize,
+    pub thread: u64,
+    pub epoch: u64,
+    pub serial: u64,
+    pub endpoint: usize,
+    pub frame: u64,
+    pub deadline: u64,
+    pub offered: u64,
+    pub accepted: u64,
+    pub delivered: u64,
+    pub terminal: u64,
+    pub completed: u64,
+    pub returned: u64,
+    /// 0 absent, 1 accepted, 2 delivered, 3 terminal, 4 acknowledged/withdrawn.
+    pub phase: u8,
+    /// Raw caller status, meaningful only after terminal/completion.
+    pub status: u64,
+    /// Actual scalar offered by callee, including replies after expiry.
+    pub reply: u64,
+    pub has_reply: bool,
+    pub dirty: bool,
+}
+impl Row {
+    pub fn write(self, out: &mut dyn Write) -> fmt::Result {
+        writeln!(
+            out,
+            "EVROSION_M8_PRESENT_TRACE phase={} caller_actor={} caller_thread={} epoch={} serial={} endpoint={} frame={} deadline={} offered={} accepted={} delivered={} terminal={} completed={} returned={} status={} reply={:#x} has_reply={} content=false diagnostic_only=true",
+            self.phase,
+            self.caller,
+            self.thread,
+            self.epoch,
+            self.serial,
+            self.endpoint,
+            self.frame,
+            self.deadline,
+            self.offered,
+            self.accepted,
+            self.delivered,
+            self.terminal,
+            self.completed,
+            self.returned,
+            self.status,
+            self.reply,
+            self.has_reply
+        )
+    }
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Counts {
+    pub offers: u64,
+    pub accepted: u64,
+    pub omitted: u64,
+    pub denied: u64,
+    pub last_denied_at: u64,
+    pub last_denied_status: u64,
+}
+#[derive(Clone, Copy)]
+struct Offer {
+    frame: u64,
+    deadline: u64,
+    first: u64,
+}
+pub struct Trace {
+    rows: [Row; CAPACITY],
+    counts: [Counts; ACTORS],
+    offers: [Option<Offer>; ACTORS],
+}
+impl Default for Trace {
+    fn default() -> Self {
+        Self {
+            rows: [Row::default(); CAPACITY],
+            counts: [Counts::default(); ACTORS],
+            offers: [None; ACTORS],
+        }
+    }
+}
+impl Trace {
+    pub fn offer(&mut self, caller: usize, frame: u64, deadline: u64, now: u64) {
+        self.counts[caller].offers += 1;
+        if self.offers[caller].is_none_or(|o| o.frame != frame || o.deadline != deadline) {
+            self.offers[caller] = Some(Offer {
+                frame,
+                deadline,
+                first: now,
+            });
+        }
+    }
+    pub fn offered(&self, caller: usize, frame: u64, deadline: u64) -> Option<u64> {
+        self.offers[caller]
+            .filter(|o| o.frame == frame && o.deadline == deadline)
+            .map(|o| o.first)
+    }
+    pub fn denied(&mut self, caller: usize, status: u64, now: u64) {
+        let c = &mut self.counts[caller];
+        c.denied += 1;
+        c.last_denied_at = now;
+        c.last_denied_status = status;
+    }
+    pub fn accept(&mut self, mut row: Row) -> Option<usize> {
+        self.offers[row.caller] = None;
+        let c = &mut self.counts[row.caller];
+        let ordinal = c.accepted;
+        c.accepted += 1;
+        if ordinal >= PER_ACTOR as u64 {
+            c.omitted += 1;
+            return None;
+        }
+        let slot = row.caller * PER_ACTOR + ordinal as usize;
+        row.phase = 1;
+        row.dirty = true;
+        self.rows[slot] = row;
+        Some(slot)
+    }
+    pub fn delivered(&mut self, slot: Option<usize>, now: u64) {
+        if let Some(slot) = slot {
+            let r = &mut self.rows[slot];
+            r.delivered = now;
+            r.phase = 2;
+            r.dirty = true;
+        }
+    }
+    pub fn terminal(&mut self, slot: Option<usize>, status: u64, now: u64) {
+        if let Some(slot) = slot {
+            let r = &mut self.rows[slot];
+            if r.terminal == 0 {
+                r.terminal = now;
+                r.status = status;
+                r.phase = 3;
+                r.dirty = true;
+            }
+        }
+    }
+    pub fn complete(
+        &mut self,
+        slot: Option<usize>,
+        status: u64,
+        reply: Option<u64>,
+        now: u64,
+        returned: bool,
+    ) {
+        if let Some(slot) = slot {
+            let r = &mut self.rows[slot];
+            r.completed = now;
+            r.returned = if returned { now } else { 0 };
+            r.status = status;
+            r.reply = reply.unwrap_or(0);
+            r.has_reply = reply.is_some();
+            r.phase = 4;
+            r.dirty = true;
+        }
+    }
+    /// Defer serial formatting until this credit is already terminal.
+    /// Offered/accepted/delivered timestamps remain in the immutable row.
+    pub fn pop_dirty(&mut self) -> Option<Row> {
+        let r = self.rows.iter_mut().find(|r| r.dirty && r.phase >= 3)?;
+        r.dirty = false;
+        Some(*r)
+    }
+    pub fn counts(&self, caller: usize) -> Counts {
+        self.counts[caller]
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn row(caller: usize, serial: u64) -> Row {
+        Row {
+            caller,
+            thread: 10,
+            epoch: 805,
+            serial,
+            endpoint: 37,
+            frame: 2,
+            deadline: 6261,
+            offered: 5237,
+            accepted: 5238,
+            ..Row::default()
+        }
+    }
+    #[test]
+    fn busy_same_request_keeps_first_offer_without_renewing_cut() {
+        let mut t = Trace::default();
+        t.offer(9, 2, 6261, 5237);
+        t.denied(9, 2, 5237);
+        t.offer(9, 2, 6261, 5800);
+        assert_eq!(t.offered(9, 2, 6261), Some(5237));
+        assert_eq!(t.offered(9, 2, 6262), None);
+        let mut r = row(9, 151);
+        r.offered = t.offered(9, 2, 6261).unwrap();
+        r.accepted = 6000;
+        let slot = t.accept(r);
+        assert_eq!(t.offered(9, 2, 6261), None);
+        t.delivered(slot, 6001);
+        t.complete(slot, 0, Some(2), 6259, true);
+        let end = t.pop_dirty().unwrap();
+        assert_eq!(
+            (end.offered, end.accepted, end.delivered, end.deadline),
+            (5237, 6000, 6001, 6261)
+        );
+        t.offer(9, 3, 7000, 6300);
+        assert_eq!(t.offered(9, 3, 7000), Some(6300));
+        assert_eq!(t.counts(9).offers, 3);
+    }
+    #[test]
+    fn expired_delivered_credit_keeps_identity_reply_and_original_cut() {
+        let mut t = Trace::default();
+        t.offer(9, 2, 6261, 5237);
+        let slot = t.accept(row(9, 151));
+        assert!(t.pop_dirty().is_none());
+        t.delivered(slot, 6000);
+        assert!(t.pop_dirty().is_none());
+        t.terminal(slot, 4, 6261);
+        t.terminal(slot, 5, 6262);
+        let terminal = t.pop_dirty().unwrap();
+        assert_eq!(
+            (terminal.terminal, terminal.status, terminal.deadline),
+            (6261, 4, 6261)
+        );
+        t.complete(slot, 4, Some(u64::MAX), 6263, true);
+        let end = t.pop_dirty().unwrap();
+        assert_eq!((end.epoch, end.serial, end.frame), (805, 151, 2));
+        assert_eq!(
+            (
+                end.completed,
+                end.returned,
+                end.terminal,
+                end.status,
+                end.has_reply,
+                end.reply
+            ),
+            (6263, 6263, 6261, 4, true, u64::MAX)
+        );
+        assert!(t.pop_dirty().is_none());
+    }
+    #[test]
+    fn independent_actor_prefixes_never_replace_and_omissions_are_counted() {
+        let mut t = Trace::default();
+        for n in 0..7 {
+            t.offer(9, 2, 6261, 5237);
+            let s = t.accept(row(9, n + 1));
+            assert_eq!(s.is_some(), n < 4);
+            t.complete(s, 0, Some(2), 6001, true);
+        }
+        t.offer(10, 2, 6261, 5237);
+        let s = t.accept(row(10, 99));
+        t.complete(s, 0, Some(2), 6001, true);
+        let mut rows = 0;
+        while let Some(r) = t.pop_dirty() {
+            if r.caller == 9 {
+                rows += 1;
+                assert!(r.serial <= 4);
+            }
+        }
+        assert_eq!(rows, 4);
+        assert_eq!(
+            t.counts(9),
+            Counts {
+                offers: 7,
+                accepted: 7,
+                omitted: 3,
+                ..Counts::default()
+            }
+        );
+        assert_eq!(t.counts(10).accepted, 1);
+    }
+    #[test]
+    fn preaccept_denials_and_undelivered_withdrawal_are_not_successful_replies() {
+        let mut t = Trace::default();
+        t.offer(9, 2, 6261, 5237);
+        t.denied(9, 2, 100);
+        t.offer(9, 2, 6261, 5237);
+        let slot = t.accept(row(9, 2));
+        t.terminal(slot, 4, 6261);
+        t.complete(slot, 4, None, 6261, true);
+        let r = t.pop_dirty().unwrap();
+        assert_eq!(
+            (r.delivered, r.has_reply, r.reply, r.status),
+            (0, false, 0, 4)
+        );
+        assert_eq!(t.counts(9).denied, 1);
+        assert_eq!(t.counts(9).last_denied_status, 2);
+    }
+    #[test]
+    fn successful_scalar_and_missing_caller_return_are_distinct() {
+        let mut t = Trace::default();
+        let slot = t.accept(row(9, 1));
+        t.delivered(slot, 6000);
+        t.complete(slot, 0, Some(2), 6001, true);
+        let a = t.pop_dirty().unwrap();
+        assert_eq!((a.terminal, a.status, a.reply, a.returned), (0, 0, 2, 6001));
+        let slot = t.accept(row(9, 2));
+        t.terminal(slot, 5, 6002);
+        t.complete(slot, 5, None, 6003, false);
+        let b = t.pop_dirty().unwrap();
+        assert_eq!((b.status, b.returned, b.completed), (5, 0, 6003));
+    }
+}
