diff --git a/services/workspace-root/src/root_loss_probe.rs b/services/workspace-root/src/root_loss_probe.rs
new file mode 100644
--- /dev/null
+++ b/services/workspace-root/src/root_loss_probe.rs
@@ -0,0 +1,80 @@
+//! Selected internal qualification fault; absent from the normal Root artifact.
+//! A real Dirty -> Saving -> Saved sequence arms one fixed delayed Root exit.
+//! App state is a pacing trigger only; independent cold bytes prove persistence.
+use ev_workspace_client::ui::State;
+
+pub const EXIT_CODE: u64 = 0x4d38;
+const DELAY_TICKS: u64 = 8192;
+
+#[derive(Default)]
+pub struct Probe {
+    phase: u8,
+    exit_at: Option<u64>,
+}
+impl Probe {
+    pub const fn new() -> Self {
+        Self {
+            phase: 0,
+            exit_at: None,
+        }
+    }
+    pub fn observe(&mut self, state: State, now: u64) {
+        if self.exit_at.is_some() {
+            return;
+        }
+        self.phase = match (self.phase, state) {
+            (_, State::Dirty) => 1,
+            (1, State::Saving) => 2,
+            (2, State::Saved) => {
+                self.exit_at = now.checked_add(DELAY_TICKS).filter(|n| *n != u64::MAX);
+                3
+            }
+            (2, State::Saving) => 2,
+            _ => 0,
+        };
+    }
+    pub fn due(&self, now: u64) -> bool {
+        self.exit_at.is_some_and(|at| now >= at)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn initial_saved_or_dirty_without_save_cannot_arm() {
+        let mut p = Probe::new();
+        p.observe(State::Saved, 1);
+        p.observe(State::Dirty, 2);
+        p.observe(State::Saved, 3);
+        assert!(!p.due(u64::MAX));
+    }
+    #[test]
+    fn uncertain_save_does_not_arm() {
+        let mut p = Probe::new();
+        p.observe(State::Dirty, 1);
+        p.observe(State::Saving, 2);
+        p.observe(State::Uncertain, 3);
+        p.observe(State::Saved, 4);
+        assert!(!p.due(u64::MAX));
+    }
+    #[test]
+    fn actual_sequence_has_one_fixed_delay_without_renewal() {
+        let mut p = Probe::new();
+        p.observe(State::Dirty, 1);
+        p.observe(State::Saving, 2);
+        p.observe(State::Saved, 3);
+        assert!(!p.due(3 + DELAY_TICKS - 1));
+        p.observe(State::Saved, 4000);
+        p.observe(State::Dirty, 5000);
+        assert!(p.due(3 + DELAY_TICKS));
+    }
+    #[test]
+    fn invalid_clock_overflow_cannot_force_exit() {
+        let mut p = Probe::new();
+        p.observe(State::Dirty, 1);
+        p.observe(State::Saving, 2);
+        p.observe(State::Saved, u64::MAX - 1);
+        assert!(!p.due(u64::MAX));
+    }
+}
