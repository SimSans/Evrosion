#[cfg(test)]
mod tests {
    extern crate std;
    use super::*;
    use core::cell::Cell;
    fn implementation_a(x: u32) -> Result<u32, Refusal> {
        x.checked_mul(2)
            .and_then(|v| v.checked_add(1))
            .ok_or(Refusal::Overflow)
    }
    fn implementation_b(x: u32) -> Result<u32, Refusal> {
        if x > MAX_INPUT {
            return Err(Refusal::Overflow);
        }
        let mut output = 1;
        for bit in 0..31 {
            output |= ((x >> bit) & 1) << (bit + 1);
        }
        Ok(output)
    }
    #[test]
    fn bad_shape_and_overflow_refuse_before_handler() {
        let calls = Cell::new(0);
        let request = Request { value: 137 }.encode();
        let dispatch = |b: &[u8], caps| {
            server_dispatch(b, caps, |x| {
                calls.set(calls.get() + 1);
                implementation_a(x)
            })
        };
        for n in 0..=16 {
            if n == 8 {
                continue;
            }
            let b = [0; 16];
            assert_eq!(
                Response::decode(&dispatch(&b[..n], 0), 0),
                Ok(Response::Refused(Refusal::Malformed))
            );
        }
        for pos in 0..4 {
            let mut b = request;
            b[pos] ^= 0x80;
            assert_eq!(
                Response::decode(&dispatch(&b, 0), 0),
                Ok(Response::Refused(Refusal::Malformed))
            );
        }
        assert_eq!(
            Response::decode(&dispatch(&request, 1), 0),
            Ok(Response::Refused(Refusal::Malformed))
        );
        assert_eq!(
            Response::decode(&dispatch(&Request { value: u32::MAX }.encode(), 0), 0),
            Ok(Response::Refused(Refusal::Overflow))
        );
        assert_eq!(calls.get(), 0);
        assert_eq!(
            Response::decode(&dispatch(&request, 0), 0),
            Ok(Response::Returned(275))
        );
        assert_eq!(calls.get(), 1);
    }
    #[test]
    fn decoders_are_total_and_unknown_reply_reason_opcode_or_caps_do_not_pass() {
