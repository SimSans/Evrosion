            let b = state.to_le_bytes();
            let _ = Request::decode(&b, 0);
            let _ = Response::decode(&b, 0);
            assert!(Response::decode(&b, 1).is_err());
        }
        for value in [0, 1, MAX_INPUT, u32::MAX] {
